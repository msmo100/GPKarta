generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Map {
  id          String  @id @default(cuid())
  title       String
  description String?
  isPublic    Boolean @default(false)
  embedToken  String? @unique

  centerLat   Float  @default(57.7089)
  centerLng   Float  @default(11.9746)
  defaultZoom Int    @default(12)

  // Display options
  tileLayer      String  @default("osm")
  clusterMarkers Boolean @default(false)
  showMinimap    Boolean @default(false)
  showScaleBar   Boolean @default(true)

  // Popup style
  popupBg        String?
  popupTextColor String?

  // Cluster style
  clusterColor       String?
  clusterBorderColor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  markers    Marker[]
  categories Category[]
  shapes     Shape[]
}

model Category {
  id    String @id @default(cuid())
  mapId String
  map   Map    @relation(fields: [mapId], references: [id], onDelete: Cascade)

  name  String
  color String  @default("#3B82F6")
  icon  String?

  markers Marker[]
  shapes  Shape[]

  @@unique([mapId, name])
}

model Marker {
  id         String    @id @default(cuid())
  mapId      String
  map        Map       @relation(fields: [mapId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  title       String
  description String?
  lat         Float
  lng         Float
  date        DateTime?

  // Primary image URL (from CSV import)
  imageUrl      String?

  // Extra attributes (imported from CSV)
  genderVictim      String?
  ageVictim         Float?
  genderPerpetrator String?
  punishment        String?
  punishmentYears   Float?
  region            String?

  // Arbitrary extra fields from CSV import (stored as JSON string)
  customFields      String?

  // Visual style
  shape       String  @default("pin")
  markerSize  String  @default("md")
  markerIcon  String?
  color       String?
  strokeColor String?
  strokeWidth Float   @default(1.5)
  opacity     Float   @default(1.0)
  videoUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images MarkerImage[]
}

model Shape {
  id          String    @id @default(cuid())
  mapId       String
  map         Map       @relation(fields: [mapId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  title       String?
  description String?
  type        String
  coordinates String
  color       String    @default("#2563eb")
  weight      Int       @default(3)
  fillColor   String?
  fillOpacity Float     @default(0.2)
  opacity     Float     @default(1.0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MarkerImage {
  id       String @id @default(cuid())
  markerId String
  marker   Marker @relation(fields: [markerId], references: [id], onDelete: Cascade)

  filename  String
  url       String
  order     Int    @default(0)

  createdAt DateTime @default(now())
}
